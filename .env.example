# Required: obtain a key from https://build.nvidia.com/
NVIDIA_API_KEY=

# Change these two values together when using another OpenAI-compatible endpoint.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b

# Optional local-demo overrides
AIQ_OPENSHELL_IMAGE=aiq-openshell-demo:latest
AIQ_OPENSHELL_POLICY_FILE=configs/openshell/generated/aiq-openshell-policy.yaml
AIQ_OPENSHELL_REQUIRE_HARD_LANDLOCK=false
